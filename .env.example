# Root Environment Configuration Example (MongoDB Atlas + Firebase Auth)
ENVIRONMENT=production

# MongoDB Atlas Database
MONGODB_URI=
MONGODB_DB_NAME=placement_intelligence

# Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_CREDENTIALS_JSON=

# Sandboxed Code Execution Engine (sandbox_service or judge0)
CODE_EXECUTION_MODE=sandbox_service
SANDBOX_SERVICE_URL=http://sandbox-runner:8080
SANDBOX_SHARED_SECRET=
JUDGE0_API_URL=
JUDGE0_AUTH_TOKEN=
MAX_CODE_SIZE_BYTES=65536
SUBMISSION_RATE_LIMIT_PER_MIN=15
MAX_CONCURRENT_EXECUTIONS=8
