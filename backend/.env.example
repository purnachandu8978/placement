# Placement Intelligence Backend Environment Configuration Example
PROJECT_NAME="Placement Intelligence API"
VERSION="2.0.0"
ENVIRONMENT="development"

# =====================================================================
# MongoDB Atlas Database Configuration
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# =====================================================================
MONGODB_URI=
MONGODB_DB_NAME=placement_intelligence
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
USE_MOCK_MONGODB_FOR_TESTS=false

# =====================================================================
# Firebase Admin SDK Configuration (Google Authentication & Custom Claims)
# =====================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_MOCK_AUTH_IN_DEV=true

# Optional Web SDK Public Config
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Storage & Admin Session Security Configuration
SECRET_KEY=replace-with-random-64-char-secret
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Head of Placements
UPLOAD_DIR="uploads/resumes"
MAX_FILE_SIZE_BYTES=10485760

# =====================================================================
# Cloud Object Storage Configuration (Phase 2: Cloudflare R2 / AWS S3 / Local)
# STORAGE_PROVIDER: "cloudflare_r2", "aws_s3", or "local" (fallback when keys are unset)
# =====================================================================
STORAGE_PROVIDER=cloudflare_r2
STORAGE_BUCKET_NAME=placement-resumes
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_EXPIRATION_SECONDS=900
STORAGE_SIGNING_SECRET=replace-with-secure-32-char-secret-for-signed-urls
# CODE_EXECUTION_MODE: "sandbox_service" (isolated Docker runner) or "judge0"
# =====================================================================
CODE_EXECUTION_MODE=sandbox_service
SANDBOX_SERVICE_URL=http://localhost:8088
SANDBOX_SHARED_SECRET=
JUDGE0_API_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=
MAX_CODE_SIZE_BYTES=65536
MAX_STDIN_SIZE_BYTES=16384
SUBMISSION_RATE_LIMIT_PER_MIN=15
MAX_CONCURRENT_EXECUTIONS=8
EXECUTION_QUEUE_TIMEOUT_SECONDS=10.0
